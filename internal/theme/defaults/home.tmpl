{{define "content"}}
<div class="home">
  <h1 class="home-title">{{.Site.Name}}</h1>
  {{with .Description}}<p class="home-desc">{{.}}</p>{{end}}
  {{if .Categories}}
  <nav class="category-index" aria-label="分类导航">
    {{range .Categories}}<a class="category-chip" href="{{.Href}}">{{.Name}} <span class="count">{{.Count}}</span></a>{{end}}
  </nav>
  {{end}}
  {{if .Items}}
  <div class="cards">
    {{range .Items}}{{template "card" .}}{{end}}
  </div>
  {{end}}
  {{if .ShowTagCloud}}
  <section class="tag-cloud">
    <h2>{{i18n "tags"}}</h2>
    {{range .TagCloud}}<a class="tag-chip" href="{{.Href}}">{{.DisplayName}} <span class="count">{{.Count}}</span></a>{{end}}
  </section>
  {{end}}
</div>
{{end}}