{{define "content"}}
<div class="ask-page" id="ask-shell"
  data-site-slug="{{.SiteSlug}}"
  data-session-id="{{.SessionID}}"
  data-logged-in="{{.LoggedIn}}"
  data-quota-used="{{.QuotaUsed}}"
  data-quota-limit="{{.QuotaLimit}}"
  data-login-href="/login">
  <h1>{{i18n "ask"}}</h1>
  {{if .LoggedIn}}
  <p class="ask-note">{{i18n "ask_note"}} <span class="ask-quota">{{i18n "ask_quota_label"}} {{.QuotaUsed}}/{{.QuotaLimit}}</span></p>
  <div class="chat-window">
    <div class="chat-messages" id="chat-messages">
      <div class="chat-msg chat-msg-ai">{{i18n "ask_greeting"}}</div>
    </div>
    <form class="chat-input-row" id="chat-form" method="get" action="{{.Site.PostsHref}}">
      <textarea class="chat-input" id="chat-input" rows="2" maxlength="1000" placeholder="{{i18n "ask_placeholder"}}"></textarea>
      <button class="chat-send" id="chat-send" type="submit">{{i18n "ask_send"}}</button>
    </form>
  </div>
  {{chatIsland}}
  {{else}}
  <div class="ask-login-cta">
    <p>{{i18n "ask_login_required"}}</p>
    <a class="btn btn-primary" href="/login">{{i18n "ask_go_login"}}</a>
  </div>
  {{end}}
</div>
{{end}}