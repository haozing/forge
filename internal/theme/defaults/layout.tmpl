{{define "layout"}}<!DOCTYPE html>
<html lang="{{.Site.SiteLang}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<meta name="description" content="{{.Description}}">
{{with .Canonical}}<link rel="canonical" href="{{.}}">{{end}}
{{if .NoIndex}}<meta name="robots" content="noindex, nofollow">{{end}}
{{with .Site.FaviconURL}}<link rel="icon" href="{{.}}">{{end}}
<style>{{themeCSS}}</style>
</head>
<body>
<header class="site-header"><div class="header-inner">
  <a class="site-name" href="{{.Site.HomeHref}}">{{.Site.Name}}<span class="site-domain">qidu.site</span></a>
  <nav class="site-nav">
    <a href="{{.Site.HomeHref}}">首页</a>
    <a href="{{.Site.PostsHref}}">知识库</a>
    <a href="{{.Site.HomeHref}}p/guanyu">关于</a>
  </nav>
  <form class="search-form" action="{{.Site.SearchHref}}" method="get">
    <input type="search" name="q" placeholder="{{i18n "search"}}" aria-label="{{i18n "search"}}">
  </form>
</div></header>
<main class="site-main{{if eq .Kind "home"}} site-main-wide{{end}}">
{{template "content" .}}
</main>
<footer class="site-footer">
  <span>© {{dateFmt "2006" now}} {{.Site.Name}} · qidu.site · 慢结构，长期主义</span>
  <nav>
    <a href="{{.Site.HomeHref}}">首页</a>
    <a href="{{.Site.PostsHref}}">知识库</a>
    <a href="{{.Site.HomeHref}}p/guanyu">关于</a>
    {{with .Site.RSSHref}}<a href="{{.}}">RSS</a>{{end}}
  </nav>
</footer>
</body>
</html>{{end}}