{{define "content"}}
<div class="hub">
  <nav class="ext-breadcrumbs" aria-label="Breadcrumb">
    <a href="{{.Site.HomeHref}}">首页</a> <span aria-hidden="true">&gt;</span>
    {{if .IsCategory}}<a href="/external-links">外链目录</a> <span aria-hidden="true">&gt;</span> <span>{{.CategoryLabel}}</span>
    {{else}}<span>外链目录</span>{{end}}
  </nav>

  <h1 class="hub-h2">{{if .IsCategory}}{{.CategoryLabel}}外链目录{{else}}出海外链目录 &amp; 外链 SEO 指南{{end}}</h1>

  {{if .SubmittedThanks}}
  <p class="ext-thanks">✅ 提交已收到。我们会在 1-3 个工作日内人工审核每个站点，并通过邮件通知你结果。</p>
  {{end}}

  {{if .Intro}}<p class="ext-intro">{{.Intro}}</p>{{end}}

  {{if and (not .IsCategory) .CategoryCards}}
  <section class="ext-catnav" aria-label="分类导航">
    {{range .CategoryCards}}
    <a class="ext-catcard" href="/external-links/{{.Key}}">
      <span class="ext-caticon">{{.Icon}}</span>
      <span class="ext-catname">{{.Label}}</span>
      <span class="ext-catcount">{{.Count}} 个站点</span>
    </a>
    {{end}}
  </section>
  {{end}}

  {{if and (not .IsCategory) .Featured}}
  <section class="ext-featured">
    <h2>推荐站点</h2>
    <ul class="ext-links">
      {{range .Featured}}
      <li>
        <a href="{{.URL}}" target="_blank" {{with .Rel}}rel="{{.}}"{{end}}>{{.Name}}</a>
        <span class="ext-url">{{.URL}}</span>
        <span class="ext-desc">{{.Description}}</span>
        {{if .TestedOn}}<span class="ext-tested">实测于 {{.TestedOn}}</span>{{end}}
        {{with .Skill}}<details class="ext-skill"><summary>Agent Skill — AI agent 可按此自动提交</summary><pre><code>{{.}}</code></pre></details>{{end}}
      </li>
      {{end}}
    </ul>
  </section>
  {{end}}

  {{if .IsCategory}}
  <section class="ext-listing">
    <h2>{{.CategoryLabel}} — 全部收录</h2>
    <ul class="ext-links">
      {{range .Groups}}{{range .Items}}
      <li>
        <a href="{{.URL}}" target="_blank" {{with .Rel}}rel="{{.}}"{{end}}>{{.Name}}</a>
        <span class="ext-url">{{.URL}}</span>
        <span class="ext-desc">{{.Description}}</span>
        {{if .TestedOn}}<span class="ext-tested">实测于 {{.TestedOn}}</span>{{end}}
        {{with .Skill}}<details class="ext-skill"><summary>Agent Skill — AI agent 可按此自动提交</summary><pre><code>{{.}}</code></pre></details>{{end}}
      </li>
      {{end}}{{end}}
    </ul>
    {{if .CommunityPicks}}
    <h3>社区推荐 — 来自提交者们的站点</h3>
    <ul class="ext-links ext-picks">
      {{range .CommunityPicks}}
      <li>
        <a href="{{.URL}}" target="_blank" {{with .Rel}}rel="{{.}}"{{end}}>{{.Name}}</a>
      </li>
      {{end}}
    </ul>
    {{end}}
  </section>
  {{else}}
  <section class="ext-groups">
    <h2>按分类浏览外链</h2>
    {{range .Groups}}
    <h3 id="{{.Key}}"><a href="/external-links/{{.Key}}">{{.Label}}</a></h3>
    <p class="ext-viewall"><a href="/external-links/{{.Key}}">查看「{{.Label}}」全部收录 &rarr;</a></p>
    <ul class="ext-links">
      {{range .Items}}
      <li>
        <a href="{{.URL}}" target="_blank" {{with .Rel}}rel="{{.}}"{{end}}>{{.Name}}</a>
        <span class="ext-url">{{.URL}}</span>
        <span class="ext-desc">{{.Description}}</span>
        {{if .TestedOn}}<span class="ext-tested">实测于 {{.TestedOn}}</span>{{end}}
      </li>
      {{end}}
    </ul>
    {{end}}
  </section>
  {{end}}

  {{if .Submit.Enabled}}
  <section class="ext-submit" id="submit">
    <h2>免费提交你的站点，获取外链</h2>
    <p>把你的独立站、微型 SaaS 工具或垂类博客提交到我们的目录。审核通过后，你将获得来自 qidu.site 的高质量外链，并归入最相关的分类。想推荐别人的工具？也可以留下你自己的站点，进入社区推荐位。</p>
    EXT_SUBMIT_FORM_PLACEHOLDER
    <p class="ext-guidelines-link">提交前请先阅读<a href="/external-links/submission-guidelines">收录规则</a>。</p>
  </section>
  {{end}}

  {{if not .IsCategory}}
  <section class="ext-guide">
    <h2>外链 SEO 实战指南</h2>
    <h3>什么是外链？</h3>
    <p>外链（也叫导出链接）是从你的页面指向其他域名的链接。搜索引擎把对外引用视为相关性与信任信号：链接到权威、相关的资源，能帮助用户和爬虫同时理解你的内容主题。</p>
    <h3>外链如何帮助 SEO？</h3>
    <p>链接到高质量来源能支撑主题相关性与可信度。而等式的另一端——从相关站点获得外链——至今仍是最强的排名信号之一，这正是本目录存在的意义：被这里收录，就是一条指向你站点的外链。</p>
    <h3>内链与外链的关键区别</h3>
    <p>内链连接同一域名内的页面，控制爬取权重在站内的流动；外链把你的内容与其他域名连接起来——引用来源、建立信任，并在别人链接回你时带来排名与引荐流量。</p>
    <h3>建设高质量外链的建议</h3>
    <p>做出值得被链接的东西（免费工具、原创数据、真诚的拆解），提交到本行业的精选目录，并保证每条收录描述都是原创。避免批量自动化外链——现代搜索引擎很快就会把它们贬值。</p>
  </section>

  <section class="ext-faq">
    <h2>常见问题</h2>
    <h3>什么是 SEO 里的外链？</h3>
    <p>外链是从你的网站指向其他域名页面的超链接。它引用了信息来源，帮助搜索引擎理解你内容的语境与可信度。</p>
    <h3>外链对搜索引擎排名有用吗？</h3>
    <p>有用——链接到相关、权威的来源是正面的质量信号；而从其他站点获得外链，至今仍是最强的排名因素之一。</p>
    <h3>内链和外链有什么区别？</h3>
    <p>内链连接同一域名下的页面；外链指向其他域名。健康的站点两者兼备：内链管结构，外链管引用与信任。</p>
    <h3>新网站如何积累外链？</h3>
    <p>从本行业的精选目录开始（比如本目录——提交免费），发布值得被引用的原创工具或数据，再向覆盖你主题的站点做真诚的推荐。</p>
    <h3>dofollow 和 nofollow 外链哪个更重要？</h3>
    <p>dofollow 传递排名信号，nofollow 只是提示。自然的外链画像应以来自相关、经人工审核来源的 dofollow 链接为主——这正是本目录提供的。</p>
  </section>
  {{end}}

  {{with .Pagination}}
  {{if or .PrevHref .NextHref}}
  <nav class="ext-pagination">
    {{with .PrevHref}}<a href="{{.}}">&larr; 上一页</a>{{end}}
    <span>第 {{.Page}} 页</span>
    {{with .NextHref}}<a href="{{.}}">下一页 &rarr;</a>{{end}}
  </nav>
  {{end}}
  {{end}}
</div>
{{end}}
