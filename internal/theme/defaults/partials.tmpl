{{define "card"}}
<article class="card">
  <h2 class="card-title"><a href="{{.Href}}">{{.Title}}</a></h2>
  {{with .Summary}}<p class="card-summary">{{.}}</p>{{end}}
  <footer class="card-meta">
    {{with .PublishedOn}}<time>{{.}}</time>{{end}}
    {{template "tag_chips" .Tags}}
  </footer>
</article>
{{end}}

{{define "tag_chips"}}
{{range .}}<a class="tag-chip" href="{{.Href}}">{{.DisplayName}}</a>{{end}}
{{end}}

{{define "pager"}}
{{with .Pagination.NextHref}}<a class="pager-next" href="{{.}}">{{i18n "next"}} &rarr;</a>{{end}}
{{end}}