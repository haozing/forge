{{define "content"}}
<article class="article">
  {{with .Crumbs}}<nav class="crumbs">{{range .}}<a href="{{.Href}}">{{.Name}}</a> / {{end}}</nav>{{end}}
  <h1 class="article-title">{{.Heading}}{{if not .Heading}}{{.Title}}{{end}}</h1>
  <footer class="article-meta">
    {{if gt .VersionNo 0}}<span class="article-version">v{{.VersionNo}}</span>{{end}}
    {{with .PublishedOn}}<time datetime="{{$.UpdatedISO}}">{{i18n "published"}} {{.}}</time>{{end}}
  </footer>
  {{with .TOC}}{{if gt (len .) 1}}<nav class="toc"><h2>目录</h2><ul>{{range .}}<li><a href="#{{.ID}}">{{.Text}}</a></li>{{end}}</ul></nav>{{end}}{{end}}
  <div class="article-body">{{.ContentHTML}}</div>
  {{if .Fields}}<section class="article-fields"><h2>结构化字段</h2>
    <dl>{{range .Fields}}<div class="field-row"><dt>{{if .Label}}{{.Label}}{{else}}{{.Key}}{{end}}</dt><dd>{{.Value}}</dd></div>{{end}}</dl>
  </section>{{end}}
  {{if ge (len .Publications) 2}}<details class="article-history"><summary>更新记录（{{len .Publications}}）</summary>
    <ol>{{range .Publications}}<li>v{{.VersionNo}} <time>{{.PublishedOn}}</time>{{with .ChangeNote}} &mdash; {{.}}{{end}}</li>{{end}}</ol>
  </details>{{end}}
  {{template "tag_chips" .Tags}}
  {{with .Related}}<section class="related-posts"><h2>相关文章</h2>
    <div class="cards">{{range .}}{{template "card" .}}{{end}}</div>
  </section>{{end}}
  {{if or .Prev .Next}}<nav class="neighbors">
    {{with .Prev}}<a rel="prev" href="{{.Href}}">&larr; {{.Title}}</a>{{end}}
    {{with .Next}}<a rel="next" href="{{.Href}}">{{.Title}} &rarr;</a>{{end}}
  </nav>{{end}}
</article>
{{end}}