<rss version="2.0">
<channel>
<title>{{.Site.Name}}</title>
<link>{{.Site.HomeHref}}</link>
<description>{{.Site.Name}} 最新内容</description>
<language>zh-cn</language>
<lastBuildDate>{{.LastBuildOn}}</lastBuildDate>
{{range .Items}}<item>
<title>{{.Title}}</title>
<link>{{.Href}}</link>
<guid>{{.Href}}</guid>
{{with .Summary}}<description>{{.}}</description>{{end}}
{{with .PublishedOn}}<pubDate>{{.}}</pubDate>{{end}}
</item>
{{end}}
</channel>
</rss>
