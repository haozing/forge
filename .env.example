# Agent Chunzhi startup configuration
# Copy this file to .env, then fill every required value below.
# Generate 32-byte secrets with:  openssl rand -base64 32

# Required: runtime and security
APP_ENV=production
POSTGRES_PASSWORD=
# Both secrets must be >=32 bytes AND different from each other (readyz checks).
SEARCH_CURSOR_SECRET=
QUERY_HASH_SECRET=
AGENT_MODEL_SECRET_ENCRYPTION_KEY=
AGENT_CHECKPOINT_ENCRYPTION_KEY=
# >=32 bytes; signs the DB-backed login/rate-limit buckets. Keep it stable
# across restarts or all buckets reset.
RATE_LIMIT_HMAC_KEY=

# Required in production: member-surface origin allowlist (CSRF Origin gate
# for /api/v2/ and /api/public/v2/ writes) and the public link base URL
# (invitation / password-reset links are prefixed with it; must be https).
# Exact origins only, comma separated; "*" is rejected.
MEMBER_ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_BASE_URL=https://app.example.com

# Required in production: SMTP delivery (MAILER_PROVIDER=capture is rejected).
# Delivery is async: invitations and password resets return 2xx while the
# worker retries delivery in the background (8 attempts) before giving up.
MAILER_PROVIDER=smtp
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
# Versioned email content keys, "VERSION:<base64 32-byte key>", comma
# separated; current version defaults to the first listed entry.
EMAIL_DELIVERY_KEYS=1:
#EMAIL_DELIVERY_CURRENT_KEY_VERSION=1

# Model host allowlist. Separate multiple hosts with commas.
# Configure model URLs, names and API keys as ModelEndpoints in the admin UI.
AGENT_MODEL_ALLOWED_HOSTS=api.openai.com
# Leave unset in production: allowing private egress weakens SSRF protection
# (only needed for local mock endpoints during development).
#AGENT_MODEL_ALLOW_PRIVATE_EGRESS=true

# Required in production: semantic retrieval embedding provider (all seven
# keys together, or leave ALL empty to disable semantic search).
RETRIEVAL_EMBEDDING_MANIFEST_KEY=
RETRIEVAL_EMBEDDING_ENDPOINT=
RETRIEVAL_EMBEDDING_TOKEN=
RETRIEVAL_EMBEDDING_MODEL=
RETRIEVAL_EMBEDDING_MODEL_VERSION=
RETRIEVAL_EMBEDDING_DIMENSIONS=1024
RETRIEVAL_EMBEDDING_PROTOCOL=
# Optional reranker: set all five together or leave all empty.
RETRIEVAL_RERANKER_ENDPOINT=
RETRIEVAL_RERANKER_TOKEN=
RETRIEVAL_RERANKER_MODEL=
RETRIEVAL_RERANKER_MODEL_VERSION=
RETRIEVAL_RERANKER_PROTOCOL=

# Optional: leave all OSS values empty when attachments are not needed.
OSS_REGION=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Optional rate limits (requests per minute). Login caps brute force per IP;
# open API buckets by agent credential (falls back to client IP).
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_OPEN_PER_MIN=60
# Set to "true" only when a trusted reverse proxy overwrites X-Forwarded-For;
# otherwise rate limiting keys on the socket address and ignores the header.
RATE_LIMIT_TRUST_XFF=false
RATE_LIMIT_LOGIN_IP_PER_MIN=90
# CIDR list of trusted reverse proxies (comma separated). Behind a TLS reverse
# proxy WITHOUT this, every client shares the proxy's IP bucket.
TRUSTED_PROXY_CIDRS=
